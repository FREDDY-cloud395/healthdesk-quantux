# =============================================================================
# HEALTHDESK QUANTUX — ARCHIVO MAESTRO DE VARIABLES DE ENTORNO (.env.example)
# Sistema Integral de Mesa de Ayuda Asistencial e ITIL (N1 / N2 / N3)
# =============================================================================
# Instrucciones de uso:
#   1. Copie este archivo a '.env' para desarrollo local:
#      cp .env.example .env
#   2. Para despliegue productivo, defina los valores sensibles en Vault / Cloud Run
#      o cargue '.env.production'.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. INFORMACIÓN Y AMBIENTE DE EJECUCIÓN
# -----------------------------------------------------------------------------
# Entorno activo: 'development', 'staging', 'production' o 'testing'
APP_ENV=development

# Nombre descriptivo de la plataforma y versión
APP_NAME="Quantux ServiceDesk Enterprise"
APP_VERSION="v4.0.0-DEV"

# Modo depuración (true para desarrollo local con trazas extendidas, false en producción)
DEBUG=true

# -----------------------------------------------------------------------------
# 2. RED, PUERTOS Y SERVIDOR ASGI (UVICORN)
# -----------------------------------------------------------------------------
# Host de enlace (0.0.0.0 para escuchar en todas las interfaces, 127.0.0.1 solo localhost)
HOST=0.0.0.0

# Puerto principal del servidor FastAPI/Uvicorn
# 8000: Estándar para Docker, despliegues Cloud y entorno unificado
# 8005: Puerto alternativo de desarrollo si 8000 está en uso
PORT=8000

# URL pública o dominio base accesible por los usuarios y clientes HTTP
# Utilizado para generar enlaces en correos y redirecciones
APP_BASE_URL=http://localhost:8000

# Control de Orígenes Cruzados (CORS)
# En desarrollo: "*" (permite cualquier cliente o frontend local)
# En producción: "https://tudominio.com,https://app.quantuxsalud.com"
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 3. SEGURIDAD Y CRIPTOGRAFÍA
# -----------------------------------------------------------------------------
# Clave secreta para firma de sesiones, JWT y tokens criptográficos
# ¡ADVERTENCIA! En producción genere una clave segura aleatoria: openssl rand -hex 32
SECRET_KEY=quantux-insecure-dev-key-replace-with-openssl-rand-hex-32-in-prod

# Algoritmo de encriptación y tiempo de expiración de tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# 4. CAPA DE PERSISTENCIA Y BASE DE DATOS
# -----------------------------------------------------------------------------
# Cadena de conexión SQLAlchemy / SQLModel:
#
# A) SQLite Local (Persistente en disco, predeterminado):
#    DATABASE_URL=sqlite:///./healthdesk.db
#    (o en contenedor Docker: sqlite:////app/backend/healthdesk.db)
#
# B) PostgreSQL Cloud (Cloud SQL, Supabase, Neon, AWS RDS, Render Postgres):
#    DATABASE_URL=postgresql://quantux_user:password123@db-host.internal:5432/quantux_healthdesk
#
# C) Si se deja vacío o no definido, utilizará el archivo backend/healthdesk.db
DATABASE_URL=sqlite:///./healthdesk.db

# Mostrar sentencias SQL en la consola (útil para auditoría de consultas en desarrollo)
DB_ECHO=false

# -----------------------------------------------------------------------------
# 5. MENSAJERÍA Y NOTIFICACIONES POR CORREO (SMTP)
# -----------------------------------------------------------------------------
# Permite notificar novedades de tickets a Solicitante, Soporte N1/N2/N3 y Supervisores
ENABLE_EMAIL_NOTIFICATIONS=false

# Servidor de Correo Saliente (ambas nomenclaturas SMTP_HOST y SMTP_SERVER son aceptadas)
# Ejemplos: smtp.sendgrid.net, smtp.gmail.com, mailhog, localhost
SMTP_HOST=smtp.sendgrid.net
SMTP_SERVER=smtp.sendgrid.net

# Puerto SMTP estándar:
# 587: STARTTLS (Recomendado para SendGrid, AWS SES, Gmail)
# 465: SSL/TLS Directo
# 1025: MailHog o emulador local SMTP
# 25: Sin cifrado (red interna)
SMTP_PORT=587

# Credenciales de autenticación SMTP
SMTP_USER=apikey
SMTP_PASSWORD=TU_SENDGRID_O_SMTP_PASSWORD_AQUI

# Remitente visible institucional en los correos enviados
SMTP_FROM=notificaciones@quantuxsalud.com

# -----------------------------------------------------------------------------
# 6. GESTIÓN DE ARCHIVOS Y ADJUNTOS (UPLOADS)
# -----------------------------------------------------------------------------
# Directorio donde se almacenan capturas, logs y archivos adjuntos
UPLOAD_DIR=backend/uploads

# Tamaño máximo permitido por archivo en Megabytes
MAX_UPLOAD_SIZE_MB=25

# Extensiones permitidas (separadas por coma)
ALLOWED_FILE_EXTENSIONS=.png,.jpg,.jpeg,.pdf,.log,.txt,.json,.docx,.xlsx

# -----------------------------------------------------------------------------
# 7. LOGS Y OBSERVABILIDAD
# -----------------------------------------------------------------------------
# Nivel de verbosidad de logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Formato de logs ('json' para Kubernetes/GCP Cloud Logging o 'text' para consola)
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# 8. WORKERS Y MOTORES EN SEGUNDO PLANO
# -----------------------------------------------------------------------------
# Generador continuo de simulación de incidentes y tickets en tiempo real (Cockpit)
# Activar para demostraciones ejecutivas interactivas; desactivar en producción real
ENABLE_LIVE_SIMULATOR=true

# Bot clasificador y analizador de adjuntos en segundo plano
ENABLE_FILE_BOT=true

# Intervalo de simulación en segundos
SIMULATOR_INTERVAL_SECONDS=25
