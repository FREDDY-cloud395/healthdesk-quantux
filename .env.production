# =============================================================================
# QUANTUX SERVICEDESK - CONFIGURACIÓN DE AMBIENTE DE PRODUCCIÓN (NUBE)
# =============================================================================

APP_ENV=production
APP_NAME=Quantux ServiceDesk
APP_VERSION=v3.2.0-PROD

# Puerto del servidor (Cloud Run / AWS / Railway inyectan este valor automáticamente)
PORT=8000

# Base de datos (Opcional: Si no se define, utiliza SQLite local persistido)
# Ejemplos:
# DATABASE_URL=postgresql://user:password@cloud-sql-host:5432/quantux_healthdesk
# DATABASE_URL=sqlite:///./healthdesk.db

# Configuración de Seguridad y CORS
ALLOWED_ORIGINS=*
SECRET_KEY=quantux-secret-key-prod-change-in-vault-2026

# Notificaciones y Servidor SMTP
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_FROM=soporte@quantuxsalud.com
ENABLE_EMAIL_NOTIFICATIONS=true

# Nivel de Logs (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
